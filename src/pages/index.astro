---
import { Img } from 'astro-imagetools/components';
import probe from 'probe-image-size';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { PERSONAL_INFO } from '../consts';
import { getNotionItems } from '../utils';

const notionItems = await getNotionItems({
  auth: import.meta.env.NOTION_API_KEY,
});

const orderedItems = [...notionItems].reverse();

const images = await Promise.all(
  orderedItems.map(async ({ label, href }) => {
    const size = await probe(href);

    return { label, href, size };
  }),
);

const featuredImage = images[0];
const galleryImages = images.slice(0, 33);
---

<Layout title={PERSONAL_INFO.title}>
  <div class="min-h-screen bg-[#f5f5f7] text-slate-900">
    <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 sm:px-8 lg:px-10">
      <a href="/" class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-800">
        {PERSONAL_INFO.name}
      </a>
      <nav class="flex items-center gap-6 text-sm text-slate-600">
        <a href="/about" class="transition hover:text-slate-950">About</a>
      </nav>
    </header>

    <main class="mx-auto flex max-w-7xl flex-col gap-10 px-6 pb-16 sm:px-8 lg:px-10">
      <section class="overflow-hidden rounded-[2rem] border border-black/5 bg-white shadow-[0_20px_80px_rgba(15,23,42,0.08)]">
        <div class="grid gap-8 px-6 py-10 sm:px-10 lg:grid-cols-[0.95fr_1.05fr] lg:px-12 lg:py-16">
          <div class="flex flex-col justify-center">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">
              New collection
            </p>
            <h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
              Paintings that make you feel at home
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
              Contemporary paintings designed for classical interiors, featuring warmth, calm color, and lasting impression.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="#gallery"
                class="rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white transition hover:bg-slate-800"
              >
                Browse available works
              </a>
              <a
                href="/about"
                class="rounded-full border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 transition hover:border-slate-950 hover:text-slate-950"
              >
                View artist profile
              </a>
            </div>
          </div>

          <div class="relative min-h-[460px] overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-slate-100 via-white to-slate-200 sm:min-h-[520px]">
            {
              featuredImage ? (
                <div class="absolute inset-0">
                  <Img
                    src={featuredImage.href}
                    alt={featuredImage.label}
                    format="webp"
                    width={800}
                    class="h-full w-full object-cover"
                  />
                </div>
              ) : (
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.9),_transparent_45%),linear-gradient(135deg,_#f5f5f7_0%,_#dedede_100%)]" />
              )
            }
            <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent" />
            <div class="absolute bottom-6 left-6 rounded-full border border-white/40 bg-white/15 px-4 py-2 text-sm font-medium text-white backdrop-blur">
              {featuredImage ? featuredImage.label : 'Quiet luxury in motion'}
            </div>
          </div>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="rounded-[1.75rem] border border-black/5 bg-white p-8 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Why it stands out</p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-950">Built for spaces that value clarity, texture, and presence.</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Each work is composed with balance in mind, offering a strong visual focal point for homes, studios, and contemporary interiors.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {['Size options', 'Limited editions', 'Custom framing'].map((pill) => (
            <div class="rounded-[1.5rem] border border-black/5 bg-[#f8f8f8] p-6 text-center shadow-sm">
              <p class="text-2xl font-semibold text-slate-950">{pill}</p>
              <p class="mt-2 text-sm text-slate-600">Practical details that make collecting straightforward.</p>
            </div>
          ))}
        </div>
      </section>

      <section
        id="gallery"
        class="rounded-[2rem] border border-black/5 bg-white p-6 shadow-[0_20px_80px_rgba(15,23,42,0.06)] sm:p-8 lg:p-10"
      >
        <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Selected works</p>
            <h2 class="mt-2 text-3xl font-semibold text-slate-950">A curated collection of statement pieces.</h2>
          </div>
          <p class="max-w-xl text-sm leading-6 text-slate-600">
            Browse the current selection for scale, mood, and fit within a contemporary collection.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            galleryImages.length > 0 ? (
              galleryImages.map((image) => (
                <a href={image.href} class="group overflow-hidden rounded-[1.75rem] border border-black/5 bg-slate-50">
                  <div class="aspect-[3/4] overflow-hidden sm:aspect-[4/5] lg:aspect-[5/6]">
                    <Img
                      src={image.href}
                      alt={image.label}
                      format="webp"
                      width={600}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  </div>
                  <div class="p-5">
                    <p class="text-sm font-semibold text-slate-900">{image.label}</p>
                    <p class="mt-1 text-sm text-slate-500">View full details</p>
                  </div>
                </a>
              ))
            ) : (
              <>
                {['Stillness', 'Eclipse', 'North Light'].map((item) => (
                  <div class="rounded-[1.5rem] border border-black/5 bg-gradient-to-br from-slate-100 via-white to-slate-200 p-6">
                    <div class="mb-6 h-36 rounded-[1rem] bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.95),_transparent_40%),linear-gradient(135deg,_#f5f5f7_0%,_#d6d7db_100%)]" />
                    <p class="text-lg font-semibold text-slate-900">{item}</p>
                    <p class="mt-2 text-sm text-slate-600">A polished preview for a modern collection.</p>
                  </div>
                ))}
              </>
            )
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
