---
import { SEO_INFO } from '../consts';
import { ClientRouter } from 'astro:transitions';

type Props = { title?: string };

const forceTheme = import.meta.env.FORCE_THEME || '';

const { title = 'Yeon Joo Lee' } = Astro.props;
---

<!doctype html>
<html lang="en" class={forceTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {SEO_INFO.map((tag) => <meta name={tag.name} content={tag.content} />)}
    <link rel="icon" type="image/jpeg" href="/Whistle.jpg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[#f5f5f7] text-slate-900">
    <slot />
    <script>
      import '../load-gallery.js';
    </script>
  </body>
</html>