---
interface Props {
  src: string;
  srcset?: string | undefined;
  width: number;
  height: number;
  alt: string;
  sizes: string;
  placeholder?: string | undefined;
  loading?: 'eager' | 'lazy' | undefined;
  fetchpriority?: 'high' | 'low' | 'auto' | undefined;
  class?: string | undefined;
}

const {
  src,
  srcset,
  width,
  height,
  alt,
  sizes,
  placeholder,
  loading = 'lazy',
  fetchpriority,
  class: className,
} = Astro.props;

// Letterboxed pictures (object-contain) must not paint the blur in the empty
// part of the frame. The blur is removed once the real file has loaded, so a
// leftover strip cannot stay on screen.
const contained = (className ?? '').includes('object-contain');
const background = placeholder
  ? contained
    ? `background-image:url("${placeholder}");background-size:contain;background-repeat:no-repeat;background-position:center;background-origin:content-box;background-clip:content-box;`
    : `background-image:url("${placeholder}");background-size:cover;background-repeat:no-repeat;background-position:center;`
  : undefined;
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class:list={[className]}
  style={background}
  onload={placeholder ? "this.style.backgroundImage='none'" : undefined}
/>
